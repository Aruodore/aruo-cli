{
  "name": "{{ .Project.Module }}",
  "private": true,
  "version": "0.0.0",
  "description": "{{ .Project.Description }}",
  "license": "{{ .Project.License }}",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "vue-tsc --build && vite build && tsc -p tsconfig.server.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "check:security": "npm audit --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "concurrently -k -n web,server 'vite' 'tsx watch server/index.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "typecheck": "vue-tsc --build --pretty false && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.2",
    "postgres": "3.4.7",
    "vue": "3.5.41",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "concurrently": "9.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.6.2",
    "happy-dom": "20.11.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
