[project]
name = "{{ .Project.Module }}"
version = "0.0.0"
description = "{{ .Project.Description }}"
license = "{{ .Project.License }}"
authors = [{ name = "{{ .Project.Author }}" }]
requires-python = ">=3.12"

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]
