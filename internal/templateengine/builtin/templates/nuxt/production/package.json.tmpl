{
  "name": "{{ .Project.Module }}",
  "private": true,
  "version": "0.0.0",
  "description": "{{ .Project.Description }}",
  "license": "{{ .Project.License }}",
  "author": "{{ .Project.Author }}",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "check:security": "npm audit --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "dev": "nuxt dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "nuxt": "4.5.2",
    "postgres": "3.4.7",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nuxt/eslint-config": "1.9.0",
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
