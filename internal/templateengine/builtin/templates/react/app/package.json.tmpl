    "eslint": "9.39.1",
    "jsdom": "30.0.1",
    "prettier": "3.6.2",
    "typescript": "6.0.2",
    "vite": "8.2.1",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
